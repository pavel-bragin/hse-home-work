{
  "paragraphs": [
    {
      "text": "%pyspark\nfrom pyspark.sql.types import (\n    DoubleType, IntegerType, LongType, StringType,\n    StructField, StructType, TimestampType\n)\n\nBUCKET = \"hse-1\"\n\nspark.sql(\"CREATE DATABASE IF NOT EXISTS hw2\")\nspark.sql(\"USE hw2\")\n\ntx_schema = StructType([\n    StructField(\"transaction_id\", LongType(), True),\n    StructField(\"user_id\", LongType(), True),\n    StructField(\"amount\", DoubleType(), True),\n    StructField(\"currency\", StringType(), True),\n    StructField(\"transaction_date\", TimestampType(), True),\n    StructField(\"is_fraud\", IntegerType(), True),\n])\n\nlogs_schema = StructType([\n    StructField(\"log_id\", LongType(), True),\n    StructField(\"transaction_id\", LongType(), True),\n    StructField(\"category\", StringType(), True),\n    StructField(\"comment\", StringType(), True),\n    StructField(\"log_timestamp\", TimestampType(), True),\n])\n\ntx_df = (\n    spark.read\n    .option(\"header\", \"true\")\n    .option(\"sep\", \",\")\n    .schema(tx_schema)\n    .csv(f\"s3a://{BUCKET}/raw/transactions_v2.csv\")\n)\nlogs_df = (\n    spark.read\n    .option(\"header\", \"true\")\n    .option(\"sep\", \";\")\n    .schema(logs_schema)\n    .csv(f\"s3a://{BUCKET}/raw/logs_v2.txt\")\n)\n\n(tx_df.write.mode(\"overwrite\")\n    .format(\"parquet\")\n    .saveAsTable(\"hw2.transactions_v2\"))\n\n(logs_df.write.mode(\"overwrite\")\n    .format(\"parquet\")\n    .saveAsTable(\"hw2.logs_v2\"))\n\nprint(\"transactions_v2 count:\", spark.table(\"hw2.transactions_v2\").count())\nprint(\"logs_v2 count:\", spark.table(\"hw2.logs_v2\").count())",
      "user": "anonymous",
      "dateUpdated": "2026-04-26T18:46:16+0000",
