      "focus": true,
      "$$hashKey": "object:335"
    },
    {
      "text": "%spark.pyspark\n\norders_with_rev = orders.withColumn(\"revenue\", F.col(\"qty\") * F.col(\"price\"))\n\nenriched_orders = orders_with_rev \\\n    .join(users, on=\"user_id\", how=\"left\") \\\n    .join(products, on=\"product_id\", how=\"left\")\n\nagg_df = enriched_orders.groupBy(\"city\", \"product_id\", \"product_name\").agg(\n    F.count(\"order_id\").alias(\"orders_cnt\"),\n    F.sum(\"qty\").alias(\"qty_sum\"),\n    F.sum(\"revenue\").alias(\"revenue_sum\")\n)\n\nwindow_spec = Window.partitionBy(\"city\").orderBy(F.col(\"revenue_sum\").desc())\n\nmart_city_top_products = agg_df \\\n    .withColumn(\"rank\", F.rank().over(window_spec)) \\\n    .filter(F.col(\"rank\") <= 2) \\\n    .drop(\"rank\") \\\n    .orderBy(\"city\", F.col(\"revenue_sum\").desc())",
      "user": "anonymous",
      "dateUpdated": "2026-03-03T14:36:57+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
