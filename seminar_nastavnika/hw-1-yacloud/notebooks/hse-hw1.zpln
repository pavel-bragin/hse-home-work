    {
      "text": "%spark.pyspark\n\nhdfs_path = \"hdfs:///tmp/sandbox_zeppelin/mart_city_top_products/\"\ns3_path = \"s3a://hse-1/tmp/sandbox_zeppelin/mart_city_top_products/\" \n\nmart_city_top_products.write.mode(\"overwrite\").parquet(hdfs_path)\n\nmart_city_top_products.write.mode(\"overwrite\").parquet(s3_path)\n\nresult_df = spark.read.parquet(hdfs_path)\n\nprint(\"Итоговая витрина mart_city_top_products:\")\nresult_df.show(truncate=False)",
